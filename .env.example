# Neon/Supabase gibi bir Postgres saglayicisindan alinan baglanti dizesi.
# Ornek (Neon): postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# /api/scrape ucnoktasini tetiklemek icin gereken paylasilan sir.
# - Manuel/dis cron: "x-scrape-secret" header'i olarak gonderilir (POST).
# - Vercel Cron: bu deger CRON_SECRET olarak Vercel proje ayarlarina da eklenmeli,
#   Vercel istegi otomatik "Authorization: Bearer <CRON_SECRET>" ile yapar (GET).
SCRAPE_SECRET="degistir-bu-degeri-rastgele-bir-sirle"

# AI chatbot, haber/bolum arastirmasi (/api/chat, /api/haber-arastir,
# /api/isinolsa-haber-arastir) icin Gemini API anahtari (aistudio.google.com/apikey).
GEMINI_API_KEY="AIza..."
