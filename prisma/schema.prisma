// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EducationLevel {
  ILKOGRETIM
  LISE
  ONLISANS
  LISANS
  YUKSEK_LISANS
}

enum AbonelikPlani {
  UCRETSIZ
  PRO
  PRO_PLUS
}

enum InstitutionType {
  BAKANLIK
  UNIVERSITE
  HASTANE
  BELEDIYE
  MUZE
  KIT
  DIGER
}

model Department {
  id        String           @id @default(cuid())
  name      String           @unique
  slug      String           @unique
  level     EducationLevel   // bu bolumun hangi ogrenim derecesine ait oldugu (onlisans/lisans vb.)
  aliases   DepartmentAlias[]
  postings  PostingDepartment[]
  haberler  HaberDepartment[]
  users     User[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model DepartmentAlias {
  id           String     @id @default(cuid())
  alias        String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String

  @@unique([departmentId, alias])
  @@index([alias])
}

model Posting {
  id                       String           @id @default(cuid())
  externalId               String           @unique // kaynak sitedeki benzersiz ilan id/url hash'i, dedupe icin
  title                    String
  institutionName          String
  institutionType          InstitutionType  @default(DIGER)
  ilanTuru                 String?          // kaynaktaki ham ilan turu (ör. "Sözleşmeli Personel İlanları", "İşçi İlanları")
  iller                    String[]         @default([]) // kontenjanin acildigi il/iller
  sourceName               String           // ör. "Kariyer Kapısı"
  sourceUrl                String
  educationLevels          EducationLevel[] @default([])
  departmentRequirementRaw String?          // ilanın ham "aranan nitelikler" metni
  isDepartmentRestricted   Boolean          @default(false)
  applicationStart         DateTime?
  applicationEnd           DateTime?
  publishedAt              DateTime?
  isActive                 Boolean          @default(true)
  isDemo                   Boolean          @default(false) // gercek scraper verisi gelene kadar arayuzu gostermek icin ornek kayit
  scrapedAt                DateTime         @default(now())
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  departments PostingDepartment[]

  @@index([isActive])
  @@index([isDepartmentRestricted])
  @@index([applicationEnd])
  @@index([institutionType])
  @@index([ilanTuru])
}

enum ScrapeStatus {
  RUNNING
  SUCCESS
  FAILED
}

model ScrapeRun {
  id                 String       @id @default(cuid())
  sourceName         String
  status             ScrapeStatus @default(RUNNING)
  startedAt          DateTime     @default(now())
  finishedAt         DateTime?
  postingsFound      Int?
  positionsProcessed Int?
  unmatchedCount     Int?
  staleDeactivated   Int?
  errorMessage       String?
}

model PostingDepartment {
  id           String     @id @default(cuid())
  posting      Posting    @relation(fields: [postingId], references: [id], onDelete: Cascade)
  postingId    String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  matchedAlias String?    // eşleşmeyi tetikleyen alias/terim (denetim ve hata ayıklama için)

  @@unique([postingId, departmentId])
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  // Google ile kayit olan kullanicilarda sifre yoktur (null) - bu durumda
  // e-posta/sifre ile giris reddedilir, sadece Google OAuth ile giris
  // yapilabilir.
  passwordHash   String?
  // Google hesabinin benzersiz kimligi ("sub" claim'i) - e-posta ile degil
  // bununla eslestirme yapilir, cunku e-posta kullanici tarafindan Google
  // disinda da degistirilebilir/yeniden kullanilabilir.
  googleId       String?         @unique
  adSoyad        String
  telefon        String?
  meslek         String?
  kurumTuru      String?
  // Isaretliyse kullanici acikca "kamu calisani degilim" demistir; bu
  // durumda kurumTuru/meslek alanlari gecersiz sayilir (arayuzde de
  // tiklanamaz olur). "Henuz cevaplanmadi" (null alanlar) ile bu ikisini
  // ayirt etmek icin ayri bir alan.
  kamuCalisaniDegil Boolean @default(false)
  // Odeme altyapisi henuz yok - bu alan simdilik elle/ileride kurulacak
  // odeme sistemiyle guncellenecek. "Pro" rozeti ve premium ozellik
  // kilitleri bu alana gore calisir.
  abonelikPlani  AbonelikPlani   @default(UCRETSIZ)
  departmentId   String?
  department     Department?     @relation(fields: [departmentId], references: [id])
  educationLevel EducationLevel?
  isAdmin        Boolean         @default(false)
  // Kayit formundaki KVKK onay kutucugu isaretlendiginde doldurulur; bu
  // ozellikten once kayit olmus hesaplarda bos olabilir.
  kvkkOnayTarihi DateTime?
  createdAt      DateTime        @default(now())
  // Sifre degistirildiginde artirilir; o anda gecerli tum oturumlarin
  // (JWT'lerin) kimlik dogrulamasi bu deger uzerinden yapilir, boylece
  // sifre degisince tum cihazlardaki eski oturumlar aninda gecersiz olur.
  tokenVersion   Int             @default(0)

  becayisTalepleri BecayisTalep[]
  gonderdigiMesajlar BecayisMesaj[] @relation("MesajGonderen")
  bildirimler      Bildirim[]
  sifreSifirlamaTokenlari PasswordResetToken[]
  denemeKatilimlari DenemeKatilim[]
  oturumlar        Oturum[]
  profilFotografi  ProfilFotografi?
  epostaDegisikligi EpostaDegisiklikKodu?

  // Admin panelden suresiz/sureli verilen planin bitisi; gecince plan
  // UCRETSIZ sayilir (getCurrentUser + bildirim sorgulari).
  abonelikBitis       DateTime?
  // Odeme altyapisi gelince donem sonunda otomatik yenileme. Iptal = false yapmak:
  // abonelikBitis'e dokunulmaz, kullanici odenen donem sonuna kadar plani kullanir.
  otomatikYenileme    Boolean  @default(true)
  // SMS ile dogrulanmis telefon (yalniz Pro); `telefon` degisirse sifirlanir.
  telefonDogrulandi   DateTime?
  // SMS bildirim tercihleri (Pro) - varsayilan kapali, acik onayla acilir.
  smsIlanBildirimi    Boolean  @default(false)
  smsBecayisBildirimi Boolean  @default(false)
  // Ilk kez SMS iznini verdigi an (onay kaydi).
  smsIzinTarihi       DateTime?
  telefonDogrulama    TelefonDogrulamaKodu?
  smsGonderimleri     SmsGonderim[]
}

model TelefonDogrulamaKodu {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  telefon   String
  kod       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Gonderilen (ya da saglayici yokken test modunda yazilan) her SMS.
model SmsGonderim {
  id          String   @id @default(cuid())
  // Hesap silinince kayit da silinir (telefon kisisel veri).
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String?
  telefon     String
  metin       String
  // DOGRULAMA | ILAN | BECAYIS
  tur         String
  // TEST (saglayici tanimsiz) | GONDERILDI | HATA
  durum       String
  saglayiciId String?
  hata        String?
  // ILAN SMS'inin kapsadigi en son bildirimin createdAt'i. Sonraki tarama bundan
  // yenileri sayar - SMS'in kendi zamani kullanilmaz (farkli saatler kayabilir).
  kapsamSonu  DateTime?
  olusturma   DateTime @default(now())

  @@index([userId, tur, olusturma])
  @@index([olusturma])
}

// Cihaz bazli oturum: JWT icindeki oturumId buraya bakar. Ayarlar > Guvenlik
// sayfasinda listelenir ve tek tek kapatilabilir.
model Oturum {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  // "Chrome · Windows" gibi; tarayicinin user-agent bilgisinden turetilir. IP saklanmaz.
  cihaz      String
  olusturma  DateTime  @default(now())
  sonGorulme DateTime  @default(now())
  kapatildi  DateTime?

  @@index([userId])
}

// Her istekte sorgulanan User satirini sisirmemek icin ayri tablo.
model ProfilFotografi {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  veri        Bytes
  tur         String
  guncellenme DateTime @updatedAt
}

// E-posta degisikligi: kod YENI adrese gider, dogrulaninca email guncellenir.
model EpostaDegisiklikKodu {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  yeniEmail String
  kod       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Kayit formu gonderilince hesap hemen olusturulmaz; bu tabloya bekleyen
// kayit bilgileri (sifre zaten hash'lenmis halde) ve e-postaya gonderilen
// kod kisa sureligine yazilir. Kod dogrulaninca gercek User kaydi burdaki
// bilgilerden olusturulur. E-posta basina tek aktif kayit oldugu icin
// email alani unique - yeniden kod istenince ayni satir guncellenir.
model EmailVerificationCode {
  id             String    @id @default(cuid())
  email          String    @unique
  code           String
  adSoyad        String
  passwordHash   String
  kvkkOnayTarihi DateTime
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
}

model BecayisTalep {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  meslek       String
  kurumTuru    String?
  mevcutIl     String
  mevcutIlce   String?
  istenenIller String[] @default([])
  aciklama     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  mesajlar BecayisMesaj[]

  @@index([isActive])
  @@index([mevcutIl])
}

// Bir talebe birden fazla farkli kullanici ilgi gosterip mesaj birakabilir;
// konusmaKarsiId, talep sahibi disindaki tarafin userId'sini tutarak ayni
// talep altindaki farkli konusma "thread"lerini birbirinden ayirir.
model BecayisMesaj {
  id             String       @id @default(cuid())
  talep          BecayisTalep @relation(fields: [talepId], references: [id], onDelete: Cascade)
  talepId        String
  // Gonderen hesabini silerse mesaj karsi tarafin sohbeti bozulmasin diye kalir; gonderen bosalir ("Silinmis kullanici").
  gonderen       User?        @relation("MesajGonderen", fields: [gonderenId], references: [id], onDelete: SetNull)
  gonderenId     String?
  konusmaKarsiId String
  mesaj          String
  okundu         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([talepId, konusmaKarsiId])
}

// Site yoneticisinin (admin panelden) yayimladigi, tum kullanicilarin
// gordugu genel duyurular.
model Duyuru {
  id        String   @id @default(cuid())
  baslik    String
  icerik    String
  createdAt DateTime @default(now())
}

// Kamu personel alimlariyla ilgili haberler (toplu alim duyurulari,
// sendika haberleri, gundemdeki konular vb.) - admin panelden yayimlanir,
// ana sayfada "Haberler" bolumunde gosterilir.
model Haber {
  id          String   @id @default(cuid())
  // Basliktan turetilen, SEO icin okunakli benzersiz URL parcasi - her
  // haberin kendi sayfasi (/haberler/[slug]) bu alanla adreslenir.
  slug        String   @unique
  baslik      String
  ozet        String
  kaynakUrl   String?
  // Kaynak makalenin og:image/twitter:image meta etiketinden alinan gorsel
  // URL'si - kurumun/haberin kendi yayinladigi kucuk onizleme gorseli,
  // bulunamazsa null (arayuzde yerine bir simge/gradyan gosterilir).
  gorselUrl   String?
  // gorselUrl bir kurum logosu ise true (Wikimedia'dan gelen kurum
  // logolari kucuk/kare oldugu icin arayuzde farkli gosterilir - tam
  // kaplama yerine ortalanmis/dolgu ile).
  gorselLogoMu Boolean @default(false)
  yayinTarihi DateTime @default(now())
  createdAt   DateTime @default(now())

  // Asagidaki yapilandirilmis alanlarin tumu SADECE haberin dogrulanmis
  // kaynak metninden (bkz. haberDetayCikar.ts) cikarilir - metinde acikca
  // belirtilmeyen bir bilgi ASLA uydurulmaz, bulunamazsa null/bos kalir.
  // Bu yuzden admin panelinden elle eklenen haberlerde hepsi bos olabilir.
  kurumAdi         String?
  kadroPozisyon    String?
  kontenjan        Int?
  kategori         String?
  istihdamTuru     String?
  kpssTuru         String?
  ustYas           Int?
  egitimSeviyeleri EducationLevel[] @default([])
  basvuruBaslangic DateTime?
  basvuruBitis     DateTime?
  // Serbest metin ayrinti bolumleri (neAciklandi, basvuruTakvimi,
  // kimlerBasvurabilir, ozelSartlar, dikkatEdilmesiGerekenler, sss[]) -
  // hepsi opsiyonel, bkz. HaberDetayExtract tipi (src/lib/haberDetayCikar.ts).
  detaylar Json?

  departments HaberDepartment[]

  @@index([yayinTarihi])
}

// Haberin TAM kaynak metnine gore (sadece kisa ozete degil) hesaplanan
// bolum eslesmeleri - boylece "ozette gecmeyen ama haberin icinde gecen"
// bir bolum adi da yakalanir. Haber olusturulurken bir kez hesaplanip
// saklanir, bolum sayfasinda hizli sorgu icin kullanilir.
model HaberDepartment {
  id           String     @id @default(cuid())
  haber        Haber      @relation(fields: [haberId], references: [id], onDelete: Cascade)
  haberId      String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  matchedAlias String?

  @@unique([haberId, departmentId])
}

// isinolsa.com yalnizca "boyle bir alim var" sinyali olarak kullanilir -
// icerigi asla dogrudan sitede gosterilmez. Her "lead" icin resmi bir
// kaynaktan (Resmi Gazete, kurum/bakanlik sitesi) bagimsiz arastirma
// yapilip yapilmadigini takip eder ki ayni lead tekrar tekrar (bosuna
// token harcayarak) arastirilmasin.
model IsinolsaLeadIslendi {
  id            String   @id @default(cuid())
  externalId    String   @unique
  bulundu       Boolean
  islenmeTarihi DateTime @default(now())
}

// secmeyemektarifleri.net icin ayni amacla IsinolsaLeadIslendi'nin
// esdegeri - bu site de yalnizca "boyle bir alim var" sinyali olarak
// kullanilir, icerigi asla dogrudan sitede gosterilmez.
model SecmeyemektarifleriLeadIslendi {
  id            String   @id @default(cuid())
  externalId    String   @unique
  bulundu       Boolean
  islenmeTarihi DateTime @default(now())
}

// Kullaniciya ozel bildirimler: gelen becayis mesaji, mezun oldugu
// bolume/seviyeye uygun yeni ilan vb.
model Bildirim {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tur       String
  baslik    String
  icerik    String?
  link      String?
  okundu    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, okundu])
}

// Chatbot'un konu disi mesajlarini takip eder; kademeli bekleme suresi
// icin kullanilir. visitorId, giris yapmamis ziyaretciler icin de
// calisabilmesi adina cerez tabanli anonim bir kimliktir (kullanici
// hesabina degil tarayiciya baglidir).
model ChatAbuse {
  id              String    @id @default(cuid())
  visitorId       String    @unique
  violationCount  Int       @default(0)
  lockedUntil     DateTime?
  lastViolationAt DateTime?
  createdAt       DateTime  @default(now())
}

// Giris ve sifre degistirme uc noktalarinda basarisiz deneme sayacini
// tutar (kademeli bekleme suresi icin). identifier, giris icin e-posta,
// sifre degistirme icin "user:<id>" seklindedir.
model AuthAbuse {
  id          String    @id @default(cuid())
  identifier  String    @unique
  failCount   Int       @default(0)
  lockedUntil DateTime?
  lastFailAt  DateTime?
  createdAt   DateTime  @default(now())
}

// ÖSYM merkezi KPSS tercih kilavuzlarindaki kadro istatistikleri -
// disaridan CANLI cekilmiyor (kaynak sitenin bot korumasi sunucu
// taraflii istekleri engelliyor), bir kerelik toplu bir script ile
// (scripts/kpssScrapeOneShot.ts) buraya aktarildi. Veri zaten gecmise
// donuk/durgun oldugundan periyodik yenileme gerekmiyor.
model KpssBolum {
  id              String           @id
  ad              String
  ogrenimDuzeyi   String
  toplamKontenjan Int
  minPuan         Float?
  maxPuan         Float?
  yillikAlimlar   KpssYillikAlim[]

  @@index([ogrenimDuzeyi])
}

model KpssYillikAlim {
  id        String    @id @default(cuid())
  bolumId   String
  bolum     KpssBolum @relation(fields: [bolumId], references: [id], onDelete: Cascade)
  yil       Int
  kontenjan Int

  @@unique([bolumId, yil])
}

// ÖSYM'nin resmi 2026-DGS kilavuzu TABLO-2'sinden (onlisans -> lisans
// dikey gecis eslesmeleri) bir kerelik aktarildi (scripts/dgsTabloScrapeOneShot.ts).
// onlisansAdi, KpssBolum.ad (ONLISANS olanlar) ile isim bazli eslestirilerek
// kullanilir - ayri bir foreign key yok cunku iki kaynagin id sistemleri
// farkli (biri memurlar.net kaynakli, biri doğrudan ÖSYM kodu).
model DgsGecis {
  id            String @id @default(cuid())
  onlisansKodu  String
  onlisansAdi   String
  lisansKodu    String
  lisansAdi     String
  puanTuru      String

  @@index([onlisansAdi])
}

enum DenemeDers {
  TURKCE
  MATEMATIK
  TARIH
  COGRAFYA
  VATANDASLIK
  GUNCEL
}

// KPSS deneme sinavi soru havuzu - AI tarafindan uretilen ozgun sorular
// (gercek OSYM sorulari degil, telif/bot-korumasi riskleri nedeniyle).
// Her gun GunlukDeneme bu havuzdan ornekleme yaparak o gunun sabit soru
// setini olusturur - sorular kullaniciya ozel degil, herkese ayni yayinlanir.
model DenemeSoru {
  id              String         @id @default(cuid())
  duzey           EducationLevel
  ders            DenemeDers
  soruMetni       String
  // Ortak metinli (bir parca/bilgi + birden fazla soru) bloklarda kardes
  // sorular ayni grupId'yi paylasir. Soru numaralari ("20-21. sorular...")
  // METNE GOMULMEZ - gunun denemesindeki GERCEK pozisyona gore (bu alan
  // kullanilarak) arayuzde DINAMIK hesaplanir; aksi halde soru havuzdaki
  // sirasi degistiginde (ör. yeni soru eklenince) sabit numaralar yanlis
  // kalirdi.
  grupId          String?
  // Geometri/cografya gibi gorsel gerektiren sorularda inline SVG (ornegin
  // "<svg viewBox=...>...</svg>") - yoksa null, soru sadece metinle gosterilir.
  gorselSvg       String?
  // Matematik bolumundeki geometri sorulari - soru haritasinda ayri
  // "Geometri" grubu olarak gosterilir.
  geometri        Boolean        @default(false)
  // Ders ici konu (ör. "Kesirler ve Ondalık Sayılar") - sinav sonu konu
  // analizi ve calisma tavsiyesi bunun uzerinden yapilir.
  konu            String?
  // 5 sik (A-E), sirayla
  secenekler      String[]
  // Dogru sikkin secenekler dizisindeki indeksi (0-4)
  dogruCevap      Int
  aciklama        String?
  olusturmaTarihi DateTime       @default(now())
  // Gercek KPSS kitapciklarinda sorular konuya gore sabit bir sirada gelir
  // (ör. geometri her zaman Matematik bolumunun son sorulari, ortak metinli
  // sorular bir arada) - gunluk deneme olustururken bu yazim sirasi (sira
  // alaninin kucukten buyuge) korunur, RASTGELE karistirilmaz.
  sira            Int            @default(0)
  // Gunluk deneme secimi "en az kullanilani oncelikle sec" stratejisiyle
  // calisiyor - tekrar sikligini dusurmek icin.
  kullanimSayisi  Int            @default(0)

  @@index([duzey, ders, kullanimSayisi])
}

// Bir duzey+tarih icin SABIT soru seti - olusturulduktan sonra degismez,
// o gun giren TUM kullanicilar ayni 120 soruyu ayni sirada gorur.
model GunlukDeneme {
  id         String          @id @default(cuid())
  duzey      EducationLevel
  tarih      DateTime        @db.Date
  // 120 DenemeSoru id'si, sinavdaki gosterim sirasiyla
  soruIdler  String[]
  katilimlar DenemeKatilim[]

  @@unique([duzey, tarih])
}

model DenemeKatilim {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gunlukDenemeId  String
  gunlukDeneme    GunlukDeneme @relation(fields: [gunlukDenemeId], references: [id], onDelete: Cascade)
  baslangicZamani DateTime     @default(now())
  // Doluyken sinav bitmis sayilir (sureyi doldurma veya "Bitir" butonu).
  bitisZamani     DateTime?
  // { [soruId]: secilenSecenekIndex }
  cevaplar        Json         @default("{}")
  dogruSayisi     Int?
  yanlisSayisi    Int?
  bosSayisi       Int?
  puan            Float?

  // Kullanici basina, gunluk deneme basina tek deneme hakki.
  @@unique([userId, gunlukDenemeId])
}
